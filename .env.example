# Copy to .env at the project root. Secrets stay on the backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=sqlite:///./data/autorca.db
# Optional read-only local repository root (absolute path).
REPOSITORY_ROOT=
# Optional GitHub target for the configured local repository. No secrets in UI.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_BASE_BRANCH=main
# Local tool: bind to loopback. If set, also set this in frontend/.env.local.
AUTORCA_API_TOKEN=
# Isolated unittest runner (opt-in; build only the trusted runner/Dockerfile).
SANDBOX_ENABLED=false
# Obtain using: docker image inspect autorca-runner:local --format '{{.Id}}'
SANDBOX_IMAGE=
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_DOCKER_CONTEXT=
AUTH_ENABLED=true
# Enable secure cookies when serving through HTTPS.
SECURE_COOKIES=false
PUBLIC_ORIGIN=http://127.0.0.1:3000
SESSION_HOURS=12
# embedded for native development; external for a separate python -m app.worker.
JOB_EXECUTION=embedded
# frontend/.env.local can override this server-only URL:
# BACKEND_URL=http://127.0.0.1:8000

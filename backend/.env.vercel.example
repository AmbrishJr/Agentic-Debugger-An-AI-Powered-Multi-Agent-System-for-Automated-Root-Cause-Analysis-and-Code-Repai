# Set these on the backend Vercel project, separately for Preview and Production.
# Use separate PostgreSQL databases for Preview and Production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
MIGRATE_ON_STARTUP=false
JOB_EXECUTION=vercel
AUTH_ENABLED=true
SECURE_COOKIES=true
PUBLIC_ORIGIN=https://YOUR-FRONTEND.vercel.app
SESSION_HOURS=12
AUTORCA_API_TOKEN=REPLACE_WITH_A_RANDOM_SHARED_SECRET
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=SET_IN_VERCEL_ONLY
GITHUB_REPOSITORY=OWNER/REPOSITORY
GITHUB_BASE_BRANCH=main
GITHUB_TOKEN=SET_IN_VERCEL_ONLY
SANDBOX_PROVIDER=vercel
SANDBOX_ENABLED=true
# Build runner/Dockerfile.vercel and publish to Vercel Container Registry first.
SANDBOX_VERCEL_IMAGE=vcr.vercel.com/TEAM/PROJECT/autorca-runner@sha256:REPLACE_WITH_IMAGE_DIGEST
SANDBOX_TIMEOUT_SECONDS=30
# Vercel provides OIDC/system variables. Enable System Environment Variables.
# Never put provider, database, or GitHub keys in NEXT_PUBLIC_* variables.
